{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Brand Brain Extraction Tool",
  "description": "Extract 9 brand sections from interview transcript. For EACH section with sufficient information: provide content AND exact user citation. Skip sections without user support. No turn count limit - sections validated by content and citation.",
  "tool_name": "extract_brand_brain",
  "type": "object",
  "parameters": {
    "type": "object",
    "properties": {},
    "required": []
  },
  "output": {
    "description": "Brand brain with 9 sections extracted from interview",
    "type": "object",
    "properties": {
      "brand_brain": {
        "type": "object",
        "description": "Complete brand brain with 9 sections ordered by frameworks",
        "properties": {
          "ralston_journey": {
            "description": "Brand Journey Framework (Ralston) — 5 etapas del viaje del cliente",
            "type": "object",
            "properties": {
              "stage_1_unaware": {
                "description": "What problem? I'm good.",
                "type": "string"
              },
              "stage_2_problem_aware": {
                "description": "I have a problem but don't know solutions exist.",
                "type": "string"
              },
              "stage_3_solution_aware": {
                "description": "I know solutions exist but don't trust them.",
                "type": "string"
              },
              "stage_4_product_aware": {
                "description": "I know your product but don't trust it yet.",
                "type": "string"
              },
              "stage_5_most_aware": {
                "description": "I trust your product and want to buy now.",
                "type": "string"
              },
              "current_stage": {
                "description": "Identify which stage the target audience is in",
                "type": "string",
                "enum": ["unaware", "problem_aware", "solution_aware", "product_aware", "most_aware"]
              },
              "journey_narrative": {
                "description": "Complete narrative describing the journey from unaware to purchase",
                "type": "string"
              }
            },
            "required": ["stage_1_unaware", "stage_2_problem_aware", "stage_3_solution_aware", "stage_4_product_aware", "stage_5_most_aware", "current_stage"]
          },

          "segues_stage": {
            "description": "Business Stage Framework (Segués) — Etapa actual del negocio",
            "type": "object",
            "properties": {
              "stage": {
                "description": "Current business stage",
                "type": "string",
                "enum": [
                  "seed",
                  "startup",
                  "growth",
                  "expansion",
                  "maturity"
                ]
              },
              "revenue": {
                "description": "Current monthly revenue range",
                "type": "string"
              },
              "team_size": {
                "description": "Team size",
                "type": "string"
              },
              "primary_focus": {
                "description": "What the business is focusing on right now",
                "type": "string"
              },
              "pain_points": {
                "description": "Pain points at this business stage",
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "citation_text": {
                "description": "Literal user citation from transcript supporting this section",
                "type": "string"
              }
            },
            "required": ["stage", "revenue", "team_size", "primary_focus", "pain_points", "citation_text"]
          },

          "ralston_positioning": {
            "description": "Positioning Framework (Ralston) — Cómo posicionaremos la marca",
            "type": "object",
            "properties": {
              "value_proposition": {
                "description": "Unique value proposition in one sentence",
                "type": "string"
              },
              "target_audience": {
                "description": "Primary target audience description",
                "type": "string"
              },
              "differentiator": {
                "description": "What makes this brand different",
                "type": "string"
              },
              "tagline_options": {
                "description": "3-5 tagline options",
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "positioning_statement": {
                "description": "Complete positioning statement",
                "type": "string"
              },
              "citation_text": {
                "description": "Literal user citation from transcript supporting this section",
                "type": "string"
              }
            },
            "required": ["value_proposition", "target_audience", "differentiator", "tagline_options", "positioning_statement", "citation_text"]
          },

          "mccann_brand_personality": {
            "description": "Brand Personality (McCann) — Human traits customers associate with brand",
            "type": "object",
            "properties": {
              "dominant_traits": {
                "description": "3-5 dominant personality traits",
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "supporting_traits": {
                "description": "2-3 supporting personality traits",
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "tone_voice": {
                "description": "Brand tone and voice characteristics",
                "type": "string"
              },
              "brand_voice_examples": {
                "description": "3-5 examples of brand voice in action",
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "citation_text": {
                "description": "Literal user citation from transcript supporting this section",
                "type": "string"
              }
            },
            "required": ["dominant_traits", "supporting_traits", "tone_voice", "brand_voice_examples", "citation_text"]
          },

          "ralston_brand_essence": {
            "description": "Brand Essence (Ralston) — Core heart & soul of brand",
            "type": "object",
            "properties": {
              "brand_promise": {
                "description": "What brand promises to deliver",
                "type": "string"
              },
              "brand_values": {
                "description": "Core brand values (3-5)",
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "brand_purpose": {
                "description": "Why brand exists beyond profit",
                "type": "string"
              },
              "brand_mission": {
                "description": "What brand does every day",
                "type": "string"
              },
              "brand_vision": {
                "description": "Where brand is going in future",
                "type": "string"
              },
              "citation_text": {
                "description": "Literal user citation from transcript supporting this section",
                "type": "string"
              }
            },
            "required": ["brand_promise", "brand_values", "brand_purpose", "brand_mission", "brand_vision", "citation_text"]
          },

          "storybrand_framework": {
            "description": "StoryBrand Framework — Brand narrative structure",
            "type": "object",
            "properties": {
              "character": {
                "description": "Who is the hero (customer)",
                "type": "string"
              },
              "problem": {
                "description": "What problem the hero faces",
                "type": "string"
              },
              "guide": {
                "description": "How the brand serves as guide",
                "type": "string"
              },
              "plan": {
                "description": "Simple 3-step plan to help hero",
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "success": {
                "description": "What success looks like for hero",
                "type": "string"
              },
              "failure": {
                "description": "What happens if hero doesn't act",
                "type": "string"
              },
              "citation_text": {
                "description": "Literal user citation from transcript supporting this section",
                "type": "string"
              }
            },
            "required": ["character", "problem", "guide", "plan", "success", "failure", "citation_text"]
          },

          "visual_brand_identity": {
            "description": "Visual Brand Identity — Colors, fonts, imagery",
            "type": "object",
            "properties": {
              "color_palette": {
                "description": "Primary and secondary colors",
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "hex": {
                      "type": "string"
                    },
                    "usage": {
                      "type": "string"
                    }
                  }
                }
              },
              "typography": {
                "description": "Font choices, list font family, weight, use case",
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "weight": {
                      "type": "string"
                    },
                    "use_case": {
                      "type": "string"
                    }
                  }
                }
              },
              "imagery_style": {
                "description": "Style of photography, illustrations, graphics",
                "type": "string"
              },
              "brand_mark_description": {
                "description": "Description of logo/mark",
                "type": "string"
              },
              "citation_text": {
                "description": "Literal user citation from transcript supporting this section",
                "type": "string"
              }
            },
            "required": ["color_palette", "typography", "imagery_style", "brand_mark_description", "citation_text"]
          },

          "value_proposition": {
            "description": "Value Proposition — Why choose this brand?",
            "type": "object",
            "properties": {
              "primary_benefit": {
                "description": "Main benefit/value delivered",
                "type": "string"
              },
              "secondary_benefits": {
                "description": "Additional benefits",
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "pain_points_addressed": {
                "description": "Specific pain points this solves",
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "belief_system": {
                "description": "Brand's approach to solving the problem",
                "type": "string"
              },
              "citation_text": {
                "description": "Literal user citation from transcript supporting this section",
                "type": "string"
              }
            },
            "required": ["primary_benefit", "secondary_benefits", "pain_points_addressed", "belief_system", "citation_text"]
          },

          "marketing_channels": {
            "description": "Marketing Channels — Where and how to reach audience",
            "type": "object",
            "properties": {
              "primary_channels": {
                "description": "Main marketing channels selected",
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "messaging_strategy": {
                "description": "Messaging approach for each primary channel",
                "type": "string"
              },
              "content_pillars": {
                "description": "Content themes to focus on",
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "budget_allocation": {
                "description": "Budget allocation across channels",
                "type": "string"
              },
              "timeline": {
                "description": "Immediate action plan timeline",
                "type": "string"
              },
              "citation_text": {
                "description": "Literal user citation from transcript supporting this section",
                "type": "string"
              }
            },
            "required": ["primary_channels", "messaging_strategy", "content_pillars", "budget_allocation", "timeline", "citation_text"]
          }
        }
      },

      "validation_status": {
        "description": "Overall validation status",
        "type": "string",
        "enum": ["valid", "partial", "invalid"]
      },

      "validation_details": {
        "description": "Validation details by section",
        "type": "object",
        "properties": {
          "sections_present": {
            "description": "Sections found in extraction",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sections_missing": {
            "description": "Sections not found in extraction",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sections_without_citations": {
            "description": "Sections missing required citation_text",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "issues": {
            "description": "Any issues or questions",
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },

      "llm_used": {
        "description": "Which LLM performed extraction",
        "type": "object",
        "properties": {
          "provider": {
            "type": "string",
            "enum": ["openai", "claude", "perplexity", "other"]
          },
          "model": {
            "type": "string"
          },
          "temperature": {
            "type": "number"
          },
          "tokens_used": {
            "type": "integer"
          },
          "cost_estimate_usd": {
            "type": "number"
          }
        }
      }
    },
    "required": ["brand_brain", "validation_status", "validation_details"]
  }
}
