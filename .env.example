# Brand Studio Agent — environment configuration.
#
# Copy to .env and fill in your own values. Never commit .env (it is gitignored).
# Secrets and URLs are listed with empty values. Tunables that have a built-in
# default are commented out with that default: uncomment only to override
# (an empty numeric value would break startup).

# ---- Voice and transcription -------------------------------------------------
# AssemblyAI: Voice Agent API and take transcription
ASSEMBLYAI_API_KEY=
# Speech-to-text language (ISO 639-1 code)
# STT_LANGUAGE=en

# ---- Supabase (auth, database, private storage) ------------------------------
SUPABASE_URL=
# Anonymous/public key
SUPABASE_KEY=
# Publishable key sent to the frontend
SUPABASE_PUBLISHABLE_KEY=
# Server-side key for privileged writes; keep it out of any client
SUPABASE_SERVICE_ROLE_KEY=
# Legacy HS256 fallback only; current auth verifies via the JWKS endpoint
SUPABASE_JWT_SECRET=

# ---- Google Vertex AI (Gemini text and image, Veo video) ---------------------
VERTEX_AI_PROJECT_ID=
# VERTEX_AI_LOCATION=us-central1

# ---- Research and stock media ------------------------------------------------
# YouTube Data API key for catalog demand research
YOUTUBE_API_KEY=
# Stock B-roll providers
PEXELS_API_KEY=
PIXABAY_API_KEY=

# ---- Billing (Stripe) --------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price IDs per credit pack; must match the mode (test/live) of the secret key
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_STUDIO=
# Where a 402 Payment Required response sends the founder
PAYMENT_URL=

# ---- Credits, sessions and rate limits ---------------------------------------
# INITIAL_SESSION_CREDITS=500
# MAX_SESSION_DURATION_SECONDS=3600
# Platform-wide spend cap in USD; free credits stop after it
# PLATFORM_SPEND_CAP_USD=120
# RATE_LIMIT_REQUESTS_PER_MINUTE=30
# SOUL_GENERATE_RATE_LIMIT_PER_MINUTE=5
# VOICE_RESERVE_RATE_LIMIT_PER_MINUTE=10
# development, staging or production
ENVIRONMENT=

# ---- Audiovisual (AI assets) -------------------------------------------------
# AV_IMAGE_MODEL=gemini-3.1-flash-lite-image
# AV_VIDEO_MODEL=veo-3.1-lite-generate-001
# AV_MUSIC_MODEL=lyria-3-clip-preview
# Allow the generated-music model (off by default; the CC0 library is used)
# AV_ALLOW_LYRIA=false
# Real-cost ceiling per video in USD
# AV_COST_CEILING_USD=1.50
# Maximum AI videos per script
# AV_MAX_AI_VIDEO=1
# Monthly AI spend brake in USD (fail-closed)
# AV_MONTHLY_AI_SPEND_CAP_USD=20
# Private storage bucket for generated assets
# AV_STORAGE_BUCKET=brand-assets
# AV_GENAI_LOCATION=us-central1
# AV_IMAGE_LOCATION=global
# Defaults to AV_GENAI_LOCATION
# AV_VIDEO_LOCATION=
# Seconds between AI video status polls and the overall timeout
# AV_VIDEO_POLL_INTERVAL=10.0
# AV_VIDEO_TIMEOUT_SECONDS=480.0

# ---- Editing and render service ----------------------------------------------
# Base URL of the render service (empty disables rendering)
RENDER_SERVICE_URL=
# Shared secret between the app and the render service; set the same value on both
RENDER_SERVICE_SECRET=
# Public base URL of this app, used to build share links
# PUBLIC_BASE_URL=https://brand-studio-agent.onrender.com
# Comma-separated hosts the render service may download inputs from
RENDER_ALLOWED_HOSTS=
# Credits: first render of an idea, later renders, re-dress
# RENDER_CREDITS=20
# RERENDER_CREDITS=5
# REDRESS_CREDITS=2
# Raw cuts allowed per founder per hour
# RAW_PER_HOUR=12
# AI editing-assistant calls allowed per founder per hour
# LLM_CALLS_PER_HOUR=30
# Auto-edit silence handling: gap kept and padding, in milliseconds
# GAP_MS=400
# PAD_MS=100
# Comma-separated filler words to cut; empty uses the built-in list
FILLERS=
# Estimated render cost per second of output, in USD
# RENDER_COST_PER_S=0.000088
# Lifetimes in seconds: signed input URLs and share links
# INPUT_URL_TTL=1800
# SHARE_TTL=604800
# HTTP timeout in seconds for calls to the render service
# HTTP_TIMEOUT=290
# Text-model timeouts in seconds
# LLM_TIMEOUT_DRESS=20
# LLM_TIMEOUT_REDRESS=10
# LLM_TIMEOUT_META=15
# Maximum size of a rendered MP4 in bytes
# MAX_OUTPUT_BYTES=47000000
