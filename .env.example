# =============================================================================
# BRAND STUDIO AGENT — ENVIRONMENT CONFIGURATION
# =============================================================================

# AssemblyAI Credentials (Required for Voice Agent API & Streaming STT)
ASSEMBLYAI_API_KEY="Your_api_here"

# Rate Limits
RATE_LIMIT_REQUESTS_PER_MINUTE=30

# Session Budget
INITIAL_SESSION_CREDITS=250
MAX_SESSION_DURATION_SECONDS=3600

# Platform Spend Cap (USD)
PLATFORM_SPEND_CAP_USD=120

# Payment Configuration
PAYMENT_URL=https://example.com/upgrade

# Speech-to-Text Language
STT_LANGUAGE=es

# Server Configuration
HOST="0.0.0.0"
PORT=8000
ENVIRONMENT="development"

# Vertex AI Configuration (required for Brand Soul generation)
# Get project_id and region from GCP console
VERTEX_AI_PROJECT_ID="your_project_id_here"
VERTEX_AI_LOCATION="us-central1"

# Supabase Configuration (Required for Google OAuth and persistent storage)
SUPABASE_URL="https://your_url_here.co"
SUPABASE_KEY="sb_api_here"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_here"
# SUPABASE_JWT_SECRET is DEPRECATED - we now use Supabase JWKS endpoints for ES256 verification
# This field is kept for backward compatibility only and is not used in production










