# =============================================================================
# BRAND STUDIO AGENT — ENVIRONMENT CONFIGURATION
# =============================================================================

# AssemblyAI Credentials (Required for Voice Agent API & Streaming STT)
ASSEMBLYAI_API_KEY="Your_api_here"

# Rate Limits
RATE_LIMIT_REQUESTS_PER_MINUTE=30

# Session Budget
INITIAL_SESSION_CREDITS=500
MAX_SESSION_DURATION_SECONDS=3600

# Payment Configuration
PAYMENT_URL=https://example.com/upgrade

# Speech-to-Text Language
STT_LANGUAGE=es

# Server Configuration
HOST="0.0.0.0"
PORT=8000
ENVIRONMENT="development"

# Optional: LLM & Market Research Providers (for later pieces)
# GEMINI_API_KEY="AIzaSy_your_api_here"
# DEEPSEEK_API_KEY="sk-your_api_here"

# Supabase Configuration (Optional - for persistent session storage)
# If not set, sessions are stored in-memory and lost on restart.
# SUPABASE_URL="https://your_url_here.co"
# SUPABASE_KEY="sb_api_here"










