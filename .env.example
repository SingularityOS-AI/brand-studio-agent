# =============================================================================
# BRAND STUDIO AGENT — ENVIRONMENT CONFIGURATION
# =============================================================================
#
# SECURITY WARNING:
# - Never commit this file with real secrets values
# - All values below are placeholders - replace with your actual secrets
# - .env is already in .gitignore - keep it that way
# - .env.example is the only config file that should be committed
#
# QUICK START:
# 1. Copy this file to .env: cp .env.example .env
# 2. Replace placeholder values with your actual secrets
# 3. Set correct permissions: chmod 600 .env (Linux/Mac)
# 4. Restart your application
# =============================================================================

# =============================================================================
# REQUIRED API KEYS
# =============================================================================
# These are REQUIRED for the application to work

# AssemblyAI API Key (Required for Voice Agent API & Streaming STT)
# Get it from: https://app.assemblyai.com/account/apikeys
ASSEMBLYAI_API_KEY="your_assemblyai_api_key_here"

# Supabase URL (Required for Google OAuth and persistent storage)
# Get it from: https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL="https://your_project_id.supabase.co"

# Supabase Anonymous/Public Key (Required for client-side access)
# Get it from: https://supabase.com/dashboard/project/_/settings/api
SUPABASE_KEY="your_supabase_anon_key_here"

# Supabase Publishable Key (for frontend)
# Get it from: https://supabase.com/dashboard/project/_/settings/api
SUPABASE_PUBLISHABLE_KEY="your_supabase_publishable_key_here"

# =============================================================================
# OPTIONAL BUT RECOMMENDED API KEYS
# =============================================================================
# These enhance functionality but basic features work without them

# Vertex AI Project ID (Required for Brand Soul generation)
# Get it from: https://console.cloud.google.com/projectselector2/home/dashboard
VERTEX_AI_PROJECT_ID="your_project_id_here"

# YouTube Data API Key (Optional, for Demand Validation)
# Get it from: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY="your_youtube_api_key_here"

# =============================================================================
# PAYMENT CONFIGURATION (Stripe)
# =============================================================================
# Required for Stripe billing and payments

# Stripe Secret Key (Required for checkout and webhook handling)
# TEST MODE: sk_test_xxx
# LIVE MODE (PRODUCTION): sk_live_xxx
# Get it from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key_here"

# Stripe Webhook Secret (Required for webhook signature verification)
# Get it from: https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET="whsec_your_stripe_webhook_secret_here"

# =============================================================================
# DEPRECATED CONFIGURATION
# =============================================================================
# These fields are kept for backward compatibility only and are not used
# in production. The application now uses Supabase JWKS endpoints for ES256
# verification instead of JWT secrets.

# SUPABASE_JWT_SECRET is DEPRECATED - we now use Supabase JWKS endpoints for
# ES256 verification. This field is kept for backward compatibility only.
# SUPABASE_JWT_SECRET=""

# =============================================================================
# RATE LIMITING CONFIGURATION
# =============================================================================

# General API rate limit (requests per minute per IP)
RATE_LIMIT_REQUESTS_PER_MINUTE=30

# Brand Soul generation rate limit (stricter, as it calls Vertex AI)
SOUL_GENERATE_RATE_LIMIT_PER_MINUTE=5

# Voice reserve endpoint rate limit (called during voice sessions)
VOICE_RESERVE_RATE_LIMIT_PER_MINUTE=10

# =============================================================================
# SESSION BUDGET CONFIGURATION
# =============================================================================

# Initial credits per new user session
INITIAL_SESSION_CREDITS=500

# Maximum session duration in seconds (server-enforced)
# Default: 3600 seconds (1 hour), maximum: 10800 seconds (3 hours)
MAX_SESSION_DURATION_SECONDS=3600

# Platform spend cap (USD) - stops granting free credits after this amount
# Default: $120 USD
PLATFORM_SPEND_CAP_USD=120

# =============================================================================
# PAYMENT CONFIGURATION
# =============================================================================

# Payment URL for 402 Payment Required response
# Update this for production
PAYMENT_URL=https://example.com/upgrade

# =============================================================================
# AI CONFIGURATION
# =============================================================================

# Speech-to-Text language (ISO 639-1 code)
# Options: es (Spanish), en (English), pt (Portuguese), etc.
STT_LANGUAGE=es

# Vertex AI location (region)
# See: https://cloud.google.com/vertex-ai/docs/general/locations
VERTEX_AI_LOCATION=us-central1

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================

# Server host binding (0.0.0.0 for public, 127.0.0.1 for local only)
HOST="0.0.0.0"

# Server port
PORT=8000

# Environment (development, staging, production)
ENVIRONMENT="development"

# =============================================================================
# NOTES
# =============================================================================
#
# For production deployment:
# - Use LIVE mode Stripe keys (sk_live_*)
# - Set ENVIRONMENT="production"
# - Use HTTPS for SUPABASE_URL
# - Set strong rate limits based on your capacity
# - Monitor your spending caps (PLATFORM_SPEND_CAP_USD)
# - Use a real payment URL in PAYMENT_URL
# - Ensure your Stripe webhooks are configured correctly
#
# For Render/Vercel/AWS deployment:
# - Set these as environment variables in your deployment platform
# - Do NOT upload .env file to production
# - Each platform has its own environment variable configuration
#
# Real Stripe Price IDs (TEST MODE):
# - Starter (550 credits, $9): price_1UEbb70StQbwtwVc8mTCMm4Q
# - Pro (1800 credits, $29): price_1UEbcq0StQbwtwVcahleC7WN
# - Studio (4000 credits, $59): price_1UEbdv0StQbwtwVc3TMmj93B
#
# For LIVE MODE, you must create NEW price IDs in Stripe.
# NEVER use test mode price_ids in production.
